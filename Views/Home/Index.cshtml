@{
    ViewData["Title"] = "Home Page";
}

<div class="px-4 py-5 text-center">
    <h1 class="display-4 text-primary fw-bold">DEVTEST Sales System</h1>
    <p class="lead text-muted col-lg-8 mx-auto">
        Manage salespeople, customers, and orders in one place.
    </p>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body text-center">
                <h5 class="card-title text-primary fw-semibold">Orders</h5>
                <p class="card-text text-muted">View, add, and manage all sales orders.</p>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-primary">Go to Orders</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body text-center">
                <h5 class="card-title text-primary fw-semibold">Customers</h5>
                <p class="card-text text-muted">View and manage customer records.</p>
                <a asp-controller="Customer" asp-action="Index" class="btn btn-primary">Go to Customers</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body text-center">
                <h5 class="card-title text-primary fw-semibold">Salespeople</h5>
                <p class="card-text text-muted">View and manage sales staff records.</p>
                <a asp-controller="Salesperson" asp-action="Index" class="btn btn-primary">Go to Salespeople</a>
            </div>
        </div>
    </div>
</div>